# ─── AdvisorConnect — Local Dev Environment Variables ─────────────────────────
# Copy to .env and fill in real values before running docker-compose up.
# NEVER commit .env to version control.

# JWT
JWT_SECRET=local-dev-secret-change-in-production-at-least-32-chars

# Stripe (test keys — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Mail (use Mailtrap for local dev — https://mailtrap.io)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
