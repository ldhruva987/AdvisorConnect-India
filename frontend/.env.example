# Copy to `.env.local` and fill in. Never commit real keys.
# Only variables prefixed with VITE_ are exposed to the browser bundle —
# never put a secret key here, it ships to every visitor.

# Optional — base URL for the API gateway.
# Leave blank in local dev: src/lib/axios.ts falls back to the relative `/api`,
# which vite.config.ts's server.proxy forwards to http://localhost:7180.
# Set it for deployed environments, e.g. https://api.advisorconnect.io
VITE_API_GATEWAY_URL=

# Required for BookingPage's Razorpay Checkout integration.
# This is the *key id* (safe to expose — it's what Checkout.js needs client-side);
# the key secret belongs only in booking-service. Grab a test-mode key id from
# https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_...
