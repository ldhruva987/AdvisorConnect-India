# Copy to `.env.local` and fill in. Never commit real keys.
# Only variables prefixed with VITE_ are exposed to the browser bundle —
# never put a secret key here, it ships to every visitor.

# Optional — base URL for the API gateway.
# Leave blank in local dev: src/lib/axios.ts falls back to the relative `/api`,
# which vite.config.ts's server.proxy forwards to http://localhost:7180.
# Set it for deployed environments, e.g. https://api.advisorconnect.io
VITE_API_GATEWAY_URL=

# Required for BookingPage's Stripe Elements integration.
# This is the *publishable* key (safe to expose); the secret key belongs only in
# booking-service. Grab a test-mode key from
# https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
